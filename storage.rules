// Cafe Connection — Firebase Storage Security Rules
// ─────────────────────────────────────────────────────────────────────────────
// Deploy with: firebase deploy --only storage
// Requires firebase.json to reference this file (already configured).
//
// Policy:
//   - All uploads require authentication.
//   - Defense in depth: rules also verify @ucar.edu email domain.
//   - Allowed storage paths cover every path the app writes to from the client.
//   - Read access on uploads is unrestricted for authenticated users; the
//     serverless functions fetch via signed/download URLs.
//
// NOTE: Firebase Admin SDK always bypasses these rules on the server side.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthedUCAR() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@ucar\\.edu$');
    }

    // ── Daily sales reports (DropBox in Weekly Ops) ───────────────────────────
    // Path: reports/{campus}/{timestamp}_{filename}
    match /reports/{campus}/{fileName} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR() &&
                       request.resource.contentType.matches('.*') &&
                       request.resource.size < 20 * 1024 * 1024; // 20 MB limit
      allow update, delete: if false;
    }

    // ── Catering event recaps ────────────────────────────────────────────────
    // Path: catering_recaps/{eventId}.pdf
    // Written server-side only (Admin SDK bypasses these rules). The download
    // URL stored on the event carries a token, so recipients of the closing
    // email can open it; signed-in UCAR users can read directly.
    match /catering_recaps/{fileName} {
      allow read:  if isAuthedUCAR();
      allow write: if false;
    }

    // ── Event order PDFs (Weekly Ops › Event Orders panel) ───────────────────
    // Path: event_orders/{timestamp}_{filename}
    match /event_orders/{fileName} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR() &&
                       request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ── Event revenue Excel uploads (Event Revenue tab) ───────────────────────
    // Path: event_revenue_uploads/{timestamp}_{filename}
    match /event_revenue_uploads/{fileName} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR() &&
                       request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ── FP&A Workday report uploads (FP&A tab) ────────────────────────────────
    // Path: fpa_uploads/{timestamp}_{filename}
    match /fpa_uploads/{fileName} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR() &&
                       request.resource.size < 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ── Catch-all: deny everything not explicitly matched ─────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
