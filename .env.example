# ── Frontend (Vite exposes these to the browser) ──────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Backend / Serverless Functions (Firebase Admin SDK) ───────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=           ← paste from the downloaded JSON
FIREBASE_ADMIN_PRIVATE_KEY=            ← paste from the downloaded JSON (the long -----BEGIN PRIVATE KEY----- block)

# ── Serverless Function Config ────────────────────────────────────────────────
# Firebase Storage bucket used for SSRF validation in /api/parse-report.
# Must match VITE_FIREBASE_STORAGE_BUCKET above.
ALLOWED_STORAGE_BUCKET=your-project.firebasestorage.app

# Google Drive folder ID containing the yearly schedule folders (e.g. "2026 ES Schedules").
GOOGLE_SCHEDULE_FOLDER_ID=
