# Never commit real credentials. Use placeholders here and store real values in your secrets manager / Vercel project settings.

# Frontend (Vite exposes these to the browser)
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Email compose client. Options: 'gmail' | 'outlook' | 'mailto'
# Defaults to 'gmail' if not set.
VITE_EMAIL_CLIENT=gmail

# ── Catering Companion ───────────────────────────────────────────────────────
# Feature gate for the /catering requester entry point and the staff Catering
# tab. Anything other than the literal string 'true' leaves the module off, in
# which case /catering falls through to the normal Cafe Connection shell.
# Keep this OFF in production until Phase 5 UAT sign-off.
VITE_CATERING_ENABLED=false

# Pilot allowlist: comma-separated emails permitted to use catering while it
# runs against production data. EMPTY means no restriction beyond the flag and
# normal roles, which is the end state once the pilot opens up.
#
# Must match cateringAllowlist() in firestore.rules - that is the enforceable
# boundary, this only gates the UI. A test asserts the two stay in step.
VITE_CATERING_ALLOWLIST=jdaskam@ucar.edu,jjhenkels@ucar.edu,lsamide@ucar.edu,ccrescenzo@ucar.edu,angiewalker@ucar.edu,jessicam@ucar.edu,michaela@ucar.edu

# Sandbox: point the Firebase SDK at the local Emulator Suite instead of a live
# project. MUST remain unset/false in production and in any preview that talks
# to a real Firebase project. See docs/catering/SANDBOX.md.
# For local sandbox work use `npm run dev:sandbox`, which loads the committed
# .env.sandbox instead of this file — you do not need to set these here.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199

# Backend / Serverless Functions (Firebase Admin SDK)
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Shared serverless function config
# Must match VITE_FIREBASE_STORAGE_BUCKET above.
ALLOWED_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
CRON_SECRET=replace-with-long-random-secret
INVITE_APP_URL=http://localhost:5173

# Google Drive folder IDs
GOOGLE_SCHEDULE_FOLDER_ID=
GOOGLE_SPECIALS_FOLDER_ID=
GOOGLE_EVENT_REPORTS_FOLDER_ID=
GOOGLE_SETUP_REPORT_FOLDER_ID=

# ── Catering Companion: notifications, recap, cron ───────────────────────────
# Master switch for outbound catering email. Leave false (or unset) until the
# service mailbox has been re-consented for the `gmail.send` OAuth scope — the
# endpoint then composes and logs each message instead of sending it.
CATERING_EMAIL_ENABLED=false

# From address on catering notifications.
CATERING_FROM_ADDRESS="UCAR Event Services <noreply@ucar.edu>"

# Catering ops distribution list, cc'd on newly created requests. Leave blank
# to send the planner their copy only.
CATERING_OPS_INBOX=

# Public base URL of the app. Used for "view your request" links and as the
# origin the nightly sweep calls its sibling endpoints on.
CATERING_APP_URL=

# Gmail OAuth for the service mailbox. Two consumers, not one:
#   - /api/ingest-email-orders  (reads the mailbox)
#   - catering notifications    (send via gmail.send)
# Leave any of the three unset and CATERING_EMAIL_ENABLED above has no effect —
# the catering endpoint stays on the log transport and sends nothing, quietly.
# Mint the refresh token with scripts/test-gmail-send.mjs.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
