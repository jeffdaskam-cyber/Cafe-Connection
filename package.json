{
  "name": "cafe-connection",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --mode sandbox",
    "build": "vite build",
    "build:sandbox": "vite build --mode sandbox",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-cafe-connection --only firestore \"node --test test/catering-rules.test.mjs\"",
    "catering:seed": "firebase emulators:exec --project demo-cafe-connection --only firestore \"node scripts/seedCateringReferenceData.mjs && node scripts/migrateCateringEvents.mjs\"",
    "emulators": "firebase emulators:start --project demo-cafe-connection",
    "emulators:exec": "firebase emulators:exec --project demo-cafe-connection",
    "sandbox": "node scripts/checkSandboxPrereqs.mjs && firebase emulators:exec --project demo-cafe-connection --ui \"node scripts/startSandbox.mjs\"",
    "catering:grant": "node scripts/grantCateringRole.mjs"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^20.1.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "knip": "^6.31.0",
    "vite": "^8.2.2"
  }
}
