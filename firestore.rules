// Cafe Connection — Firestore Security Rules
// ─────────────────────────────────────────────────────────────────────────────
// Deploy with: firebase deploy --only firestore:rules
// Requires firebase.json in the project root.
//
// Policy (Phase 10 — hardened):
//   - All data requires authentication (UCAR magic-link sign-in)
//   - Defense in depth: rules also verify @ucar.edu email domain
//   - Operational writes validate campus and owned fields
//   - cash_drops: update/delete restricted to the submitter or an admin
//   - daily_metrics, generated_reports: client writes blocked (Admin SDK only)
//   - users, user_dashboard_prefs: scoped to own document only
//
// NOTE: Firebase Admin SDK always bypasses these rules on the server side.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    // Require authenticated user with @ucar.edu email (defense in depth)
    function isAuthedUCAR() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@ucar\\.edu$');
    }

    // Look up role from the /users/{uid} document
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '');
    }
    function isAdmin() {
      return isAuthedUCAR() && userRole() == 'administrator';
    }

    // Valid campus values
    function isValidCampus(campus) {
      return campus in ['Mesa Lab', 'Foothills', 'Center Green'];
    }

    // Manager-or-above check against the /user_roles/{uid} document
    function isManagerOrAbove() {
      return isAuthedUCAR() &&
             get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in
               ['manager', 'senior_leader', 'administrator'];
    }

    // ── Catering Companion helpers ─────────────────────────────────────────
    // NOTE: these read /user_roles, which is the authoritative role store
    // (written by api/update-user-role.mjs and AdminPage.jsx). The older
    // userRole() helper above reads /users, which never carries a role field —
    // do not reuse it here. See docs/catering/PHASES.md.

    function cateringRole() {
      return isAuthedUCAR()
        ? get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isAdministratorRole() {
      return cateringRole() == 'administrator';
    }

    // ── Catering pilot allowlist ───────────────────────────────────────────
    // While the module runs against production data with a small set of named
    // users, every catering path is additionally gated on the signed-in email.
    //
    // Without this, enabling the feature flag in production would let ANY
    // @ucar.edu user who reaches /catering self-provision as a `requester` and
    // file real requests, and would show the staff console to every manager.
    //
    // An EMPTY list means "no restriction" — that is the end state when the
    // pilot opens up, and it is what the rules unit tests run against by
    // default so the rest of the suite keeps testing role behavior rather than
    // the allowlist.
    //
    // Mirrored by CATERING_ALLOWLIST in src/config/features.js, which gates the
    // UI. That one is a convenience; this one is the boundary.
    function cateringAllowlist() {
      return [
        'jdaskam@ucar.edu',
        'jjhenkels@ucar.edu',
        'lsamide@ucar.edu',
        'ccrescenzo@ucar.edu',
        'angiewalker@ucar.edu',
        'jessicam@ucar.edu',
        'michaela@ucar.edu'
      ];
    }

    function cateringAllowed() {
      return isAuthedUCAR() &&
             (cateringAllowlist().size() == 0 ||
              request.auth.token.email.lower() in cateringAllowlist());
    }

    // Staff access to catering, which is manager-or-above AND on the pilot
    // allowlist. Used in place of isManagerOrAbove() throughout the catering
    // rules so a manager outside the pilot sees nothing.
    function isCateringStaff() {
      return isManagerOrAbove() && cateringAllowed();
    }

    // Fields a requester may change on their own event after submission.
    // Mirrors REQUESTER_EDITABLE_FIELDS in src/catering/schema.js — the rules
    // unit tests assert the two lists stay in sync. Enumerated explicitly
    // rather than allow-by-default (build plan §3).
    function requesterEditableFields() {
      return [
        'plannerName', 'plannerEmail', 'plannerPhone',
        'onsiteContactName', 'onsiteContactEmail', 'onsiteContactPhone',
        'secondaryContactName', 'secondaryContactEmail', 'secondaryContactPhone',
        'organization', 'lcpo',
        'eventName', 'startDate', 'endDate', 'startTime', 'expectedAttendance',
        'needsCatering', 'needsAlcohol', 'deliveryMethod', 'lunchOnOwnCount',
        'setupNotes', 'airwallClosureTimeline',
        'agendaType', 'agendaLink', 'agendaFileUrl', 'specialRequests',
        'securityNotes', 'needsSecurity',
        'custodialNotes', 'needsCustodial',
        'accessDoorsNotes', 'needsAccessDoors',
        'sustainabilityNotes', 'needsSustainability',
        'buildingId', 'primaryRoomId', 'roomIds', 'campus',
        'paymentMethod', 'projectIds', 'projectAllocations', 'paymentNotes',
        'updatedAt'
      ];
    }

    function onlyRequesterFieldsChanged() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(requesterEditableFields());
    }

    // Revenue amounts are never writable from a client, by anyone. Phase 4
    // rolls revenue up via the Admin SDK, which bypasses these rules.
    function noRevenueFields() {
      return !request.resource.data.keys().hasAny(['estimatedRevenue', 'actualRevenue']);
    }

    // A requester may edit their own event's content at any point in its life —
    // including after staff confirm it — but the approval and lifecycle statuses
    // stay staff-owned and must not move on a content edit.
    function requesterContentEdit() {
      return onlyRequesterFieldsChanged() &&
             request.resource.data.requestStatus == resource.data.requestStatus &&
             request.resource.data.lifecycleStatus == resource.data.lifecycleStatus;
    }

    // The one status change a requester may make: submitting their own draft
    // (draft -> submitted), optionally alongside content edits in the same write.
    function requesterSubmitsDraft() {
      return resource.data.requestStatus == 'draft' &&
             request.resource.data.requestStatus == 'submitted' &&
             request.resource.data.lifecycleStatus == resource.data.lifecycleStatus &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(requesterEditableFields().concat(['requestStatus']));
    }

    function ownsCateringEvent(eventId) {
      return isAuthedUCAR() &&
             get(/databases/$(database)/documents/catering_events/$(eventId)).data.createdBy
               == request.auth.uid;
    }

    // ── daily_metrics ──────────────────────────────────────────────────────
    // Read: any authenticated UCAR user
    // Write: server-side only (Admin SDK via /api/parse-report)
    match /daily_metrics/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if false;
    }

    // ── event_revenue ─────────────────────────────────────────────────────
    // Read/Write: any authenticated UCAR user (writes via Admin SDK + client)
    match /event_revenue/{document=**} {
      allow read: if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      (userRole() in ['manager', 'administrator']) &&
                      isValidCampus(request.resource.data.campus) &&
                      request.resource.data.year is int &&
                      request.resource.data.month is int &&
                      request.resource.data.month >= 1 &&
                      request.resource.data.month <= 12 &&
                      request.resource.data.revenue is number &&
                      request.resource.data.type in ['internal', 'external'];
    }

    // ── fpa_facts ──────────────────────────────────────────────────────────
    // Read: any authenticated UCAR user
    // Write: server-side only (Admin SDK via /api/parse-fpa-report)
    match /fpa_facts/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if false;
    }

    // ── fpa_uploads ────────────────────────────────────────────────────────
    // Read: any authenticated UCAR user (for upload history / audit)
    // Write: server-side only
    match /fpa_uploads/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if false;
    }

    // ── event_orders ───────────────────────────────────────────────────────
    // Read:   any authenticated UCAR user
    // Create: any authenticated UCAR user (upload via firebase.js)
    // Update/Delete: blocked — files are immutable after upload
    match /event_orders/{doc} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR();
      allow update, delete: if false;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // Own profile only. Document ID == Firebase Auth UID.
    // Administrators can read all user documents (for Admin panel display names).
    match /users/{userId} {
      allow read: if isAuthedUCAR() && request.auth.uid == userId;
      allow read: if isAuthedUCAR() &&
                     get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";
      allow write: if isAuthedUCAR() && request.auth.uid == userId;
      allow write: if isAuthedUCAR() &&
                      get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";
    }

    // ── weekly_schedules ───────────────────────────────────────────────────
    match /weekly_schedules/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if isAuthedUCAR();
    }

    // ── cafe_specials ──────────────────────────────────────────────────────
    match /cafe_specials/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      isValidCampus(request.resource.data.campus);
    }

    // ── cash_drops ─────────────────────────────────────────────────────────
    // Create: any authenticated UCAR user; created_by_uid must match their UID
    // Update/Delete: submitter only, or an admin
    match /cash_drops/{doc} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR() &&
                       isValidCampus(request.resource.data.campus) &&
                       request.resource.data.created_by_uid == request.auth.uid &&
                       request.resource.data.amount is number;
      allow update, delete: if isAuthedUCAR() &&
                               (resource.data.created_by_uid == request.auth.uid ||
                                isAdmin());
    }

    // ── beos ───────────────────────────────────────────────────────────────
    match /beos/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      isValidCampus(request.resource.data.campus);
    }

    // ── event_reports ──────────────────────────────────────────────────────
    match /event_reports/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      isValidCampus(request.resource.data.campus);
    }

    // ── setup_reports ──────────────────────────────────────────────────────
    match /setup_reports/{doc} {
      allow read:  if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      isValidCampus(request.resource.data.campus);
    }

    // ── generated_reports ──────────────────────────────────────────────────
    // Immutable after creation — no updates or deletes from the client
    match /generated_reports/{doc} {
      allow read:   if isAuthedUCAR();
      allow create: if isAuthedUCAR();
      allow update, delete: if false;
    }

    // ── user_dashboard_prefs ───────────────────────────────────────────────
    // Own document only. Document ID == Firebase Auth UID.
    match /user_dashboard_prefs/{userId} {
      allow read, write: if isAuthedUCAR() && request.auth.uid == userId;
    }

    // ── user_roles ──────────────────────────────────────────────────────────
    // Role-based access control. Document ID == Firebase Auth UID.
    match /user_roles/{uid} {
      // Any authenticated user can read their own role document
      allow read: if request.auth != null && request.auth.uid == uid;

      // Administrators can read all role documents (for Admin panel)
      allow read: if isAuthedUCAR() &&
                     get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";

      // First-login activation: the invited user creates their own role doc,
      // but only if a matching pending invite exists and the role matches.
      allow create: if request.auth != null && request.auth.uid == uid
                       && exists(/databases/$(database)/documents/pending_invites/$(request.auth.token.email))
                       && request.resource.data.role ==
                          get(/databases/$(database)/documents/pending_invites/$(request.auth.token.email)).data.role;

      // Catering Companion self-provisioning: any @ucar.edu user arriving at
      // /catering with no existing role becomes a `requester` (build plan
      // §6.1). Deliberately narrow — the role value is pinned to the literal
      // 'requester', so this path can never mint a staff role, and it cannot
      // overwrite an existing doc because create does not apply to one.
      // Gated on the pilot allowlist as well: while catering runs against
      // production data, this is the path that would otherwise let anyone at
      // UCAR who reaches /catering create themselves an account and file real
      // requests.
      allow create: if cateringAllowed() && request.auth.uid == uid
                       && request.resource.data.role == 'requester'
                       && request.resource.data.email == request.auth.token.email;

      // Only administrators can update or delete role docs
      allow update, delete: if request.auth != null
                               && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";
    }

    // ── pending_invites ────────────────────────────────────────────────────
    // Admin-created invite records keyed by invited email address.
    // Writes (create/update) happen exclusively via serverless functions
    // which use the Admin SDK and bypass these rules. The only client-side
    // write permitted is the invited user consuming (deleting) their own
    // invite doc on first login.
    match /pending_invites/{email} {
      // Admins can read the full list for the Admin tab
      allow read: if isAuthedUCAR() &&
                     exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";

      // Invited user may read their own invite doc (needed to pick up role
      // during first-login activation in AuthContext).
      allow read: if request.auth != null && request.auth.token.email == email;

      // No direct client create/update — all writes go through serverless functions.
      allow create, update: if false;

      // Invited user may delete their own invite doc after first-login activation.
      allow delete: if request.auth != null &&
                       request.auth.token.email == email;
    }

    // ── vendor_links ───────────────────────────────────────────────────────
    // Read: any authenticated UCAR user
    // Write: administrators only
    match /vendor_links/{vendorId} {
      allow read: if isAuthedUCAR();
      allow write: if isAuthedUCAR() &&
                      get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == "administrator";
    }

    // ── event_report_entries ───────────────────────────────────────────────
    // Native event report authoring (one document per event booking)
    // Read: any authenticated UCAR user
    // Create/Update/Delete: manager, senior_leader, or administrator only
    match /event_report_entries/{entryId} {
      allow read: if isAuthedUCAR();
      allow create, update, delete: if isManagerOrAbove();
    }

    // ── setup_report_entries ───────────────────────────────────────────────
    // Native setup/reset report authoring (one document per setup/reset task)
    // Read: any authenticated UCAR user
    // Create/Update/Delete: manager, senior_leader, or administrator only
    match /setup_report_entries/{entryId} {
      allow read: if isAuthedUCAR();
      allow create, update, delete: if isManagerOrAbove();
    }

    // ── catering_events ────────────────────────────────────────────────────
    // Catering Companion (build plan §3, reconciled in docs/catering/).
    // Read:   own events, or manager-and-above
    // Create: requester creates their own, as requestStatus 'submitted'
    // Update: requester may change only allowlisted fields, at any point in the
    //         event's life (a confirmed event stays editable), and may submit
    //         their own draft; manager-and-above may change anything
    // Delete: manager-and-above only
    match /catering_events/{eventId} {
      allow read: if cateringAllowed() &&
                     (resource.data.createdBy == request.auth.uid || isCateringStaff());

      // A requester may create their own event as a draft (save and leave) or
      // submit it outright.
      allow create: if cateringAllowed() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.requestStatus in ['draft', 'submitted'] &&
                       request.resource.data.lifecycleStatus == 'open' &&
                       noRevenueFields();

      allow update: if cateringAllowed() && (
                       (resource.data.createdBy == request.auth.uid &&
                        (requesterContentEdit() || requesterSubmitsDraft()) &&
                        noRevenueFields())
                       || isCateringStaff()
                     );

      allow delete: if isCateringStaff();

      // Schedule days and their meal selections travel with the event: the
      // owner may manage them, staff may manage anything.
      match /catering_schedule_days/{dayId} {
        allow read, write: if (ownsCateringEvent(eventId) && cateringAllowed()) || isCateringStaff();

        match /catering_meal_selections/{mealId} {
          allow read, write: if (ownsCateringEvent(eventId) && cateringAllowed()) || isCateringStaff();
        }
      }

      // Rooms are booked in a separate calendar system BEFORE this form is
      // filled in, so a room recorded here is an existing booking rather than
      // a request awaiting approval. The owner records it and may correct it;
      // staff may also edit it. (The build plan's §3 modelled this as a
      // staff-only assignment, which does not match how rooms are actually
      // booked — see docs/catering/DATA_MODEL.md §6.)
      match /catering_event_rooms/{roomBookingId} {
        allow read, write: if (ownsCateringEvent(eventId) && cateringAllowed()) || isCateringStaff();
      }
    }

    // ── catering_schedule_days (collection group) ──────────────────────────
    // A collection-group query is matched by collection ID only — the nested
    // rule under /catering_events/{eventId} does NOT apply to it. The staff
    // console's cross-event daily schedule needs this rule to run at all.
    //
    // Staff-only on purpose: a requester reads their own schedule days through
    // the nested path above, and must not be able to sweep every event's.
    match /{path=**}/catering_schedule_days/{dayId} {
      allow read: if isCateringStaff();
    }

    // ── rooms / buildings ──────────────────────────────────────────────────
    // Reference data seeded from the AppSheet source. Readable by any signed-in
    // UCAR user (the intake form needs it); administrator-only to change.
    match /rooms/{roomId} {
      allow read:  if isAuthedUCAR();
      allow write: if isAdministratorRole();
    }

    match /buildings/{buildingId} {
      allow read:  if isAuthedUCAR();
      allow write: if isAdministratorRole();
    }

    // ── catering_menu_items ────────────────────────────────────────────────
    // Priced menu catalog for the intake form's structured menu pickers. Same
    // shape as rooms/buildings: any signed-in UCAR user reads it (the form
    // needs it), administrator-only to change (the "Seed menu catalog" action
    // and future in-app editing).
    match /catering_menu_items/{itemId} {
      allow read:  if isAuthedUCAR();
      allow write: if isAdministratorRole();
    }

    // ── Catch-all: deny everything not explicitly matched ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
