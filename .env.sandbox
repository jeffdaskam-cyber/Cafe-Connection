# Catering Companion — sandbox environment (Vite `--mode sandbox`).
#
# SAFE TO COMMIT. Every value here is a placeholder for the local Firebase
# Emulator Suite. The "demo-" project ID prefix is recognized by the emulators
# as offline-only, so this configuration cannot reach a live Firebase project
# even by accident. Never put real credentials in this file.
#
# Usage:
#   Terminal 1:  npm run emulators
#   Terminal 2:  npm run dev:sandbox     -> http://localhost:5173/catering

# Point the Firebase SDK at the local emulators instead of a live project.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199

# Emulator-only Firebase config. Not secrets — see the note above.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-cafe-connection
VITE_FIREBASE_STORAGE_BUCKET=demo-cafe-connection.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Catering Companion feature gate — on in the sandbox, off everywhere else
# until Phase 5 UAT sign-off.
VITE_CATERING_ENABLED=true
# Empty on purpose: the local sandbox is offline and single-user, so the pilot
# allowlist only gets in the way. Production sets it. See docs/catering/SANDBOX.md.
VITE_CATERING_ALLOWLIST=
